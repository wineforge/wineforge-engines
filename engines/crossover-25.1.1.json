{
  "$schema": "./schema.json",
  "schema_version": 1,
  "id": "crossover-25.1.1",
  "upstream": {
    "name": "CodeWeavers CrossOver sources",
    "homepage": "https://media.codeweavers.com/pub/crossover/source/"
  },
  "source": {
    "version": "25.1.1",
    "url": "https://media.codeweavers.com/pub/crossover/source/crossover-sources-25.1.1.tar.gz",
    "sha256": "7cdcfcfaee8991f7958b5ccb2837c0facec6e8e681cd3ada8d2745bddbe27d13",
    "sha256_provenance": "Independently calculated from the official HTTPS archive on 2026-08-13; no publisher checksum sidecar was available.",
    "source_date_epoch": 1757927700
  },
  "build": {
    "source_subdirectory": "sources/wine",
    "targets": ["linux-x86_64", "macos-x86_64"],
    "patches": [
      {
        "path": "patches/25.1.1/0001-winemac-strict-window-isolation.patch",
        "sha256": "30d9e8178eec3d03c006fcf4a70d8cbcab4c4d8abcd537fe05e72ed3c9f1bdd1",
        "provenance": "Wineforge process-local policy for hiding and restoring Wine-owned floating windows when the application resigns or regains activity.",
        "targets": ["macos-x86_64"]
      },
      {
        "path": "patches/25.1.1/0002-winemac-process-input-configuration.patch",
        "sha256": "2b8e19cd6155a01d496ea2b30a0cc6e60ee9b3145044064e7d55900d4cf1c353",
        "provenance": "Wineforge process-local transport for the pinned Mac driver's existing modifier mapping and precise physical scrolling policies.",
        "targets": ["macos-x86_64"]
      }
    ]
  },
  "capabilities": {
    "protocol": 1,
    "declarations": [
      {
        "id": "input.keyboard.preset.mac-native",
        "version": 1,
        "state": "provided",
        "evidence_patches": ["patches/25.1.1/0002-winemac-process-input-configuration.patch"],
        "targets": ["macos-x86_64"],
        "transport": {
          "kind": "environment",
          "variables": [
            "WINEFORGE_INPUT_LEFT_COMMAND_IS_CTRL",
            "WINEFORGE_INPUT_RIGHT_COMMAND_IS_CTRL",
            "WINEFORGE_INPUT_LEFT_OPTION_IS_ALT",
            "WINEFORGE_INPUT_RIGHT_OPTION_IS_ALT"
          ]
        }
      },
      {
        "id": "input.keyboard.mapping",
        "version": 1,
        "state": "planned",
        "targets": ["macos-x86_64"]
      },
      {
        "id": "input.scroll.keyboard-to-scroll",
        "version": 1,
        "state": "planned",
        "targets": ["macos-x86_64"]
      },
      {
        "id": "input.scroll.precise",
        "version": 1,
        "state": "provided",
        "evidence_patches": ["patches/25.1.1/0002-winemac-process-input-configuration.patch"],
        "targets": ["macos-x86_64"],
        "transport": {
          "kind": "environment",
          "variables": ["WINEFORGE_INPUT_PRECISE_SCROLLING"]
        }
      },
      {
        "id": "input.scroll.horizontal",
        "version": 1,
        "state": "provided",
        "evidence_patches": ["patches/25.1.1/0002-winemac-process-input-configuration.patch"],
        "targets": ["macos-x86_64"]
      },
      {
        "id": "input.scroll.momentum",
        "version": 1,
        "state": "provided",
        "evidence_patches": ["patches/25.1.1/0002-winemac-process-input-configuration.patch"],
        "targets": ["macos-x86_64"]
      },
      {
        "id": "input.scroll.drag",
        "version": 1,
        "state": "planned",
        "targets": ["macos-x86_64"]
      },
      {
        "id": "macos.window-isolation.strict",
        "version": 1,
        "state": "provided",
        "evidence_patches": [
          "patches/25.1.1/0001-winemac-strict-window-isolation.patch",
          "patches/25.1.1/0002-winemac-process-input-configuration.patch"
        ],
        "targets": ["macos-x86_64"],
        "scope": "process",
        "transport": {
          "kind": "environment",
          "variables": ["WINEFORGE_STRICT_WINDOW_ISOLATION"]
        },
        "privacy": {
          "requires_external_window_observation": false,
          "requires_accessibility": false,
          "requires_screen_recording": false,
          "requires_input_monitoring": false
        }
      },
      {
        "id": "host.bridge",
        "version": 1,
        "state": "planned",
        "targets": ["linux-x86_64", "macos-x86_64"],
        "transports": ["unix-socket", "named-pipe"]
      }
    ]
  },
  "redistribution": {
    "status": "review_required",
    "reason": "Component-level licence and corresponding-source obligations must be reviewed before public binary release."
  }
}
