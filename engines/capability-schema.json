{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wineforge.example/schemas/engine-capabilities-v1.json",
  "title": "Wineforge engine capabilities",
  "$defs": {
    "target": {
      "enum": ["linux-x86_64", "macos-x86_64"]
    },
    "capabilityId": {
      "enum": [
        "input.keyboard.preset.mac-native",
        "input.keyboard.mapping",
        "input.scroll.keyboard-to-scroll",
        "input.scroll.precise",
        "input.scroll.horizontal",
        "input.scroll.momentum",
        "input.scroll.drag",
        "macos.window-isolation.strict",
        "host.bridge"
      ]
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "variables"],
      "properties": {
        "kind": { "const": "environment" },
        "variables": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "WINEFORGE_INPUT_LEFT_COMMAND_IS_CTRL",
              "WINEFORGE_INPUT_RIGHT_COMMAND_IS_CTRL",
              "WINEFORGE_INPUT_LEFT_OPTION_IS_ALT",
              "WINEFORGE_INPUT_RIGHT_OPTION_IS_ALT",
              "WINEFORGE_INPUT_PRECISE_SCROLLING",
              "WINEFORGE_STRICT_WINDOW_ISOLATION"
            ]
          }
        }
      }
    },
    "sourceDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "provided" } } },
          "then": { "required": ["evidence_patches"] }
        },
        {
          "if": { "properties": { "id": { "const": "macos.window-isolation.strict" } } },
          "then": { "required": ["scope", "privacy", "transport"] }
        },
        {
          "if": { "properties": { "id": { "const": "host.bridge" } } },
          "then": { "required": ["transports"] }
        }
      ],
      "required": ["id", "version", "state", "targets"],
      "properties": {
        "id": { "$ref": "#/$defs/capabilityId" },
        "version": { "const": 1 },
        "state": { "enum": ["planned", "provided"] },
        "evidence_patches": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^patches/[0-9]+\\.[0-9]+\\.[0-9]+/[a-z0-9][a-z0-9.-]+\\.patch$"
          }
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/target" }
        },
        "transport": { "$ref": "#/$defs/transport" },
        "scope": { "const": "process" },
        "privacy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requires_external_window_observation",
            "requires_accessibility",
            "requires_screen_recording",
            "requires_input_monitoring"
          ],
          "properties": {
            "requires_external_window_observation": { "const": false },
            "requires_accessibility": { "const": false },
            "requires_screen_recording": { "const": false },
            "requires_input_monitoring": { "const": false }
          }
        },
        "transports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["unix-socket", "named-pipe"] }
        }
      }
    },
    "providedDeclaration": {
      "allOf": [
        { "$ref": "#/$defs/sourceDeclaration" },
        {
          "type": "object",
          "required": ["state", "evidence_patches"],
          "properties": { "state": { "const": "provided" } }
        }
      ]
    },
    "runtimeDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "kind", "engine_id", "target", "protocol", "provided"],
      "properties": {
        "schema_version": { "const": 1 },
        "kind": { "const": "wineforge-engine-capabilities" },
        "engine_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" },
        "target": { "$ref": "#/$defs/target" },
        "protocol": { "const": 1 },
        "provided": {
          "type": "array",
          "items": { "$ref": "#/$defs/providedDeclaration" }
        }
      }
    }
  },
  "$ref": "#/$defs/runtimeDocument"
}
