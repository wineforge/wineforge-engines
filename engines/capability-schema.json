{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wineforge.example/schemas/engine-capabilities-v1.json",
  "title": "Wineforge engine capabilities",
  "$defs": {
    "target": {
      "enum": ["linux-x86_64", "macos-x86_64"]
    },
    "state": {
      "enum": ["planned", "provided"]
    },
    "inputMapping": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "provided" } } },
          "then": { "required": ["evidence_patches"] }
        }
      ],
      "required": ["id", "version", "state", "targets", "features"],
      "properties": {
        "id": { "const": "input.mapping" },
        "version": { "const": 1 },
        "state": { "$ref": "#/$defs/state" },
        "evidence_patches": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "pattern": "^patches/[0-9]+\\.[0-9]+\\.[0-9]+/[a-z0-9][a-z0-9.-]+\\.patch$" }
        },
        "targets": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "$ref": "#/$defs/target" }
        },
        "features": {
          "type": "object",
          "additionalProperties": false,
          "required": ["keyboard", "keyboard_to_scroll", "precise_scroll", "horizontal_scroll", "momentum", "drag_scroll"],
          "properties": {
            "keyboard": { "type": "boolean" },
            "keyboard_to_scroll": { "type": "boolean" },
            "precise_scroll": { "type": "boolean" },
            "horizontal_scroll": { "type": "boolean" },
            "momentum": { "type": "boolean" },
            "drag_scroll": { "type": "boolean" }
          }
        }
      }
    },
    "macosWindowIsolation": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "provided" } } },
          "then": { "required": ["evidence_patches"] }
        }
      ],
      "required": ["id", "version", "state", "targets", "scope", "privacy"],
      "properties": {
        "id": { "const": "macos.window-isolation" },
        "version": { "const": 1 },
        "state": { "$ref": "#/$defs/state" },
        "evidence_patches": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "pattern": "^patches/[0-9]+\\.[0-9]+\\.[0-9]+/[a-z0-9][a-z0-9.-]+\\.patch$" }
        },
        "targets": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "const": "macos-x86_64" }
        },
        "scope": { "const": "process" },
        "privacy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requires_external_window_observation", "requires_accessibility", "requires_screen_recording", "requires_input_monitoring"],
          "properties": {
            "requires_external_window_observation": { "const": false },
            "requires_accessibility": { "const": false },
            "requires_screen_recording": { "const": false },
            "requires_input_monitoring": { "const": false }
          }
        }
      }
    },
    "hostBridge": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "provided" } } },
          "then": { "required": ["evidence_patches"] }
        }
      ],
      "required": ["id", "version", "state", "targets", "transports"],
      "properties": {
        "id": { "const": "host.bridge" },
        "version": { "const": 1 },
        "state": { "$ref": "#/$defs/state" },
        "evidence_patches": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "pattern": "^patches/[0-9]+\\.[0-9]+\\.[0-9]+/[a-z0-9][a-z0-9.-]+\\.patch$" }
        },
        "targets": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "$ref": "#/$defs/target" }
        },
        "transports": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "enum": ["unix-socket", "named-pipe"] }
        }
      }
    },
    "sourceDeclaration": {
      "oneOf": [
        { "$ref": "#/$defs/inputMapping" },
        { "$ref": "#/$defs/macosWindowIsolation" },
        { "$ref": "#/$defs/hostBridge" }
      ]
    },
    "providedDeclaration": {
      "allOf": [
        { "$ref": "#/$defs/sourceDeclaration" },
        {
          "type": "object",
          "required": ["state", "evidence_patches"],
          "properties": { "state": { "const": "provided" } }
        }
      ]
    },
    "runtimeDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "kind", "engine_id", "target", "protocol", "provided"],
      "properties": {
        "schema_version": { "const": 1 },
        "kind": { "const": "wineforge-engine-capabilities" },
        "engine_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" },
        "target": { "$ref": "#/$defs/target" },
        "protocol": { "const": 1 },
        "provided": {
          "type": "array",
          "items": { "$ref": "#/$defs/providedDeclaration" }
        }
      }
    }
  },
  "$ref": "#/$defs/runtimeDocument"
}
